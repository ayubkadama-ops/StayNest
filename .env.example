NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
# Render generates these automatically when using render.yaml.
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret
# TiDB Cloud Serverless uses the MySQL protocol and port 4000.
MYSQL_HOST=your-tidb-host.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=staynest
MYSQL_USER=your-tidb-username
MYSQL_PASSWORD=replace-me
# Set true for a remote TLS database; local MySQL uses a non-TLS connection by default.
MYSQL_SSL=false
S3_REGION=us-east-1
S3_BUCKET=staynest-media
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
ADMIN_GATE_USERNAME=replace-with-admin-gate-username
ADMIN_GATE_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use the Render URL in production and localhost during local development.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GA4_PROPERTY_ID=407878348
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\staynest\ga4-service-account.json
PASSWORD_RESET_BASE_URL=http://127.0.0.1:3000
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=
LOG_LEVEL=info
