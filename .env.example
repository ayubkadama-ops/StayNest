NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
APP_ORIGIN=http://localhost:8000
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
# Render generates these automatically when using render.yaml.
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret
# TiDB Cloud Serverless uses the MySQL protocol and port 4000.
MYSQL_HOST=your-tidb-host.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=staynest
MYSQL_USER=your-tidb-username
MYSQL_PASSWORD=replace-me
# Set true for a remote TLS database; local MySQL uses a non-TLS connection by default.
MYSQL_SSL=false
S3_REGION=us-east-1
S3_BUCKET=staynest-media
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudinary stores public listing/profile images and the bundled raster assets.
CLOUDINARY_CLOUD_NAME=s9p5ymwd
CLOUDINARY_API_KEY=923699335673225
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_ASSETS_ENABLED=false
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
ADMIN_GATE_USERNAME=replace-with-admin-gate-username
ADMIN_GATE_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use the Render URL in production and localhost during local development.
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
API_UPSTREAM_URL=http://127.0.0.1:3000
MARKETPLACE_URL=http://localhost:8000
GA4_PROPERTY_ID=407878348
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\staynest\ga4-service-account.json
PASSWORD_RESET_BASE_URL=http://127.0.0.1:3000
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=
LOG_LEVEL=info
