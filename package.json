{
  "name": "staynest-real-estate-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:api\" \"vite --host 0.0.0.0\"",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^7.1.5",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@google-analytics/data": "^5.2.1",
    "@tidbcloud/serverless": "^0.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.35.4"
  }
}
